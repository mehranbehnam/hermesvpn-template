# HermesVPN — فایل‌های محرمانه‌ای که باید خودتان روی سرور بسازید (هیچ‌کدام در این ریپو نیست).
# هر خط: مسیر فایل = چه چیزی داخلش بنویسید. دسترسی همه 600 و مالک root.
/root/.hermes-bot-token            = توکن ربات مدیریت تلگرام (از BotFather)
/root/.hermes-customer-bot-token   = توکن ربات فروش تلگرام
/root/.hermesvpn-openrouter-key    = کلید OpenRouter برای دستیار هوشمند (sk-or-...)
/root/.hermes-paid-webhook-secret  = یک رشته‌ی تصادفی برای وب‌هوک پیامک بانک
/root/.hermes-vakif-webhook-secret = (اختیاری) رشته‌ی تصادفی وب‌هوک دوم
/root/.hermes-iyzico-config.json   = (اختیاری) تنظیمات درگاه پرداخت
/home/ubuntu/antifilter/.secrets/bale_admin_token = (اختیاری) توکن ربات مدیریت در بله
# کلید امضای فایل‌های قفل‌دار .hvpn: یک بار بسازید (engine/tunnel، بخش README) — خصوصی بماند.
# کلید امضای اپ اندروید: keystore خودتان + apps/android/../keystore/keystore.properties
