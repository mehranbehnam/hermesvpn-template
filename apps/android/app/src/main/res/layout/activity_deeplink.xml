<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050B14"
    android:padding="28dp">

    <ImageView
        android:id="@+id/linkLogo"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@string/app_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/linkTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/linkTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/deeplink_working_title"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/linkLogo"
        app:layout_constraintBottom_toTopOf="@id/linkMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/linkMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:textColor="#A9C2D4"
        android:textSize="15sp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/linkTitle"
        app:layout_constraintBottom_toTopOf="@id/linkProgress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/linkProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="#34C8F0"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/linkMessage"
        app:layout_constraintBottom_toTopOf="@id/linkAction"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/linkAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/deeplink_go_connect"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:visibility="gone"
        android:layout_marginTop="26dp"
        app:layout_constraintTop_toBottomOf="@id/linkProgress"
        app:layout_constraintBottom_toTopOf="@id/linkBuild"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- نسخه‌ی بیلد: وقتی چیزی کار نمی‌کند، اولین چیزی که باید بدانیم
    این است که کاربر دقیقاً کدام نسخه را نصب دارد. -->
    <TextView
        android:id="@+id/linkBuild"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#4A5E6E"
        android:textSize="12sp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
