<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_chip"
        android:padding="8dp"
        android:src="@drawable/ic_back"
        android:contentDescription="Back"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dns_settings"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toTopOf="@id/backButton"
        app:layout_constraintBottom_toBottomOf="@id/backButton"
        app:layout_constraintStart_toEndOf="@id/backButton" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/backButton"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/SettingsSectionLabel"
                android:text="@string/dns_section_provider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="6dp"
                android:layout_marginBottom="8dp">

                <RadioGroup
                    android:id="@+id/dnsRadioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/dnsCloudflare"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dns_cloudflare"
                        android:textColor="@color/text_primary"
                        android:padding="12dp"
                        android:buttonTint="@color/primary" />

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/separator" />

                    <RadioButton
                        android:id="@+id/dnsGoogle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dns_google"
                        android:textColor="@color/text_primary"
                        android:padding="12dp"
                        android:buttonTint="@color/primary" />

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/separator" />

                    <RadioButton
                        android:id="@+id/dnsAdguard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dns_adguard"
                        android:textColor="@color/text_primary"
                        android:padding="12dp"
                        android:buttonTint="@color/primary" />

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/separator" />

                    <RadioButton
                        android:id="@+id/dnsCustom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dns_custom"
                        android:textColor="@color/text_primary"
                        android:padding="12dp"
                        android:buttonTint="@color/primary" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/customDnsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="16dp"
                android:layout_marginBottom="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/settings_custom_dns"
                    app:boxBackgroundMode="none">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/dnsServerInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dns_hint"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
