<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_chip"
        android:padding="8dp"
        android:src="@drawable/ic_back"
        android:contentDescription="Back"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/purchaseTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/purchase_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/backButton"
        app:layout_constraintBottom_toBottomOf="@id/backButton"
        app:layout_constraintStart_toEndOf="@id/backButton"
        android:layout_marginStart="12dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/backButton"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ۱. انتخاب پلن -->
            <TextView
                style="@style/SettingsSectionLabel"
                android:text="@string/purchase_step_plan" />

            <LinearLayout
                android:id="@+id/plansContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/plansLoadingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/purchase_loading"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:padding="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/continueButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/purchase_continue"
                android:textAllCaps="false"
                app:cornerRadius="14dp"
                android:backgroundTint="@color/primary"
                android:layout_marginBottom="24dp"
                android:visibility="gone" />

            <!-- ۲. انتخاب روش پرداخت -->
            <LinearLayout
                android:id="@+id/methodSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SettingsSectionLabel"
                    android:text="@string/purchase_step_method" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_glass_card"
                    android:padding="6dp"
                    android:layout_marginBottom="24dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/methodCardButton"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/purchase_method_card"
                        android:textAllCaps="false"
                        android:gravity="start|center_vertical" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/methodCryptoButton"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/purchase_method_crypto"
                        android:textAllCaps="false"
                        android:gravity="start|center_vertical" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/methodBankTryButton"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/purchase_method_bank_try"
                        android:textAllCaps="false"
                        android:gravity="start|center_vertical" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/methodGatewayButton"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/purchase_method_gateway"
                        android:textAllCaps="false"
                        android:gravity="start|center_vertical" />
                </LinearLayout>
            </LinearLayout>

            <!-- ۳. جزئیات پرداخت -->
            <LinearLayout
                android:id="@+id/detailsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SettingsSectionLabel"
                    android:text="@string/purchase_step_details" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_glass_card"
                    android:padding="16dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/detailsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textIsSelectable="true"
                        android:lineSpacingExtra="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/copyButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/purchase_copy"
                        android:textAllCaps="false"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_marginTop="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openGatewayButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/purchase_open_gateway"
                        android:textAllCaps="false"
                        app:cornerRadius="14dp"
                        android:backgroundTint="@color/primary"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/uploadReceiptButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/purchase_upload_receipt"
                        android:textAllCaps="false"
                        app:cornerRadius="14dp"
                        android:backgroundTint="@color/primary"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/checkStatusButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/purchase_check_status"
                    android:textAllCaps="false"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/statusResultText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginBottom="24dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
