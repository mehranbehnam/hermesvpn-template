<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- دوربین/ویوفایندر فقط تا بالای نوار پایین کشیده می‌شه، نه کل صفحه —
    همین باعث می‌شه کادر اسکن (که وسطِ همین ویو مرکز می‌گیره) طبیعتاً بالاتر
    از وسط صفحه‌ی واقعی قرار بگیره. -->
    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/barcodeScanner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:zxing_preview_scaling_strategy="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/scanBottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/scanCloseButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="10dp"
        android:background="@drawable/bg_scan_close"
        android:src="@drawable/ic_back"
        android:contentDescription="@android:string/cancel"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/scanBottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#000000"
        android:paddingTop="14dp"
        android:paddingBottom="28dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/scanGalleryButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="14dp"
            android:background="@drawable/bg_scan_gallery"
            android:src="@drawable/ic_gallery"
            android:contentDescription="@string/configs_scan_gallery" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/configs_scan_gallery"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
