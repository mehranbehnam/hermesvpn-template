<?xml version="1.0" encoding="utf-8"?>
<!-- کارت «HermesVPN روی همه‌ی دستگاه‌هات» بالای تنظیمات (الهام از کارت «دستگاه‌های دیگرت» در اپ‌های VPN مدرن) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/devicesPromo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_promo"
    android:padding="18dp"
    android:layout_marginBottom="22dp"
    android:clickable="true"
    android:focusable="true"
    android:elevation="6dp">

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp" android:background="@drawable/bg_promo_icon" android:src="@drawable/ic_android_logo" android:importantForAccessibility="no" />
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:layout_marginStart="8dp" android:background="@drawable/bg_promo_icon" android:src="@drawable/ic_windows_logo" android:importantForAccessibility="no" />
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="@string/dev_promo_title" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:text="@string/dev_promo_sub" android:textColor="#E6FFFFFF" android:textSize="13.5sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
        <TextView android:id="@+id/promoGetWindows" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_promo_btn_main" android:drawableStart="@drawable/ic_windows_logo" android:drawablePadding="8dp"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="9dp" android:paddingBottom="9dp" android:gravity="center_vertical"
            android:text="@string/dev_get_windows" android:textColor="#1C1C1E" android:textStyle="bold" android:textSize="13.5sp" />
        <TextView android:id="@+id/promoShare" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
            android:background="@drawable/bg_promo_btn" android:drawableStart="@drawable/ic_share" android:drawablePadding="8dp" android:drawableTint="#FFFFFF"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="9dp" android:paddingBottom="9dp" android:gravity="center_vertical"
            android:text="@string/dev_share" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13.5sp" />
    </LinearLayout>
</LinearLayout>
