<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_chip"
        android:padding="8dp"
        android:src="@drawable/ic_back"
        android:contentDescription="Back"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/backButton"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:id="@+id/settingsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <!-- عنوان بزرگ، سبک iOS Large Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="@color/text_primary"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="22dp" />

            <include layout="@layout/view_devices_promo" />

            <!-- ── DEVICE ───────────────────────────────── -->
            <TextView
                style="@style/SettingsSectionLabel"
                android:text="@string/section_device" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:layout_marginBottom="26dp">

                <include
                    android:id="@+id/languageRow"
                    layout="@layout/item_value_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/separator" />

                <!-- شناسه‌ی دستگاه: برای پشتیبانی، با دکمه‌ی کپی -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/device_id"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/deviceIdText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:maxLines="1"
                            android:ellipsize="middle" />

                        <ImageButton
                            android:id="@+id/deviceIdCopyButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:padding="8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_copy"
                            android:contentDescription="@string/purchase_copy" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/device_id_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/separator" />

                <include
                    android:id="@+id/profileRow"
                    layout="@layout/item_menu_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:background="@color/separator" />

                <include
                    android:id="@+id/subscriptionInfoRow"
                    layout="@layout/item_menu_row" />
            </LinearLayout>

            <!-- ── SETTINGS ─────────────────────────────── -->
            <TextView
                style="@style/SettingsSectionLabel"
                android:text="@string/section_settings" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:layout_marginBottom="26dp">

                <include
                    android:id="@+id/tunnelSettingsRow"
                    layout="@layout/item_menu_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:background="@color/separator" />

                <include
                    android:id="@+id/dnsSettingsRow"
                    layout="@layout/item_menu_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:background="@color/separator" />

                <include
                    android:id="@+id/routeSettingsRow"
                    layout="@layout/item_menu_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:background="@color/separator" />

                <include
                    android:id="@+id/subscriptionSettingsRow"
                    layout="@layout/item_menu_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:background="@color/separator" />

                <include
                    android:id="@+id/speedTestRow"
                    layout="@layout/item_menu_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:background="@color/separator" />

                <include
                    android:id="@+id/appearanceRow"
                    layout="@layout/item_menu_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:background="@color/separator" />

                <include
                    android:id="@+id/updateRow"
                    layout="@layout/item_menu_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:background="@color/separator" />

                <include
                    android:id="@+id/aboutRow"
                    layout="@layout/item_menu_row" />
            </LinearLayout>

            <!-- ── COMMUNITY ────────────────────────────── -->
            <TextView
                style="@style/SettingsSectionLabel"
                android:text="@string/section_community" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card">

                <include
                    android:id="@+id/telegramChannelRow"
                    layout="@layout/item_menu_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="54dp"
                    android:background="@color/separator" />

                <include
                    android:id="@+id/supportRow"
                    layout="@layout/item_menu_row" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
