<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_chip"
        android:padding="8dp"
        android:src="@drawable/ic_back"
        android:contentDescription="Back"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tunnel_settings"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toTopOf="@id/backButton"
        app:layout_constraintBottom_toBottomOf="@id/backButton"
        app:layout_constraintStart_toEndOf="@id/backButton" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/backButton"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/SettingsSectionLabel"
                android:text="@string/tunnel_section_apps" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:layout_marginBottom="24dp">

                <include
                    android:id="@+id/perAppRow"
                    layout="@layout/item_value_row" />
            </LinearLayout>

            <TextView
                style="@style/SettingsSectionLabel"
                android:text="@string/tunnel_section_behavior" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="4dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <CheckBox
                        android:id="@+id/bypassLanCheck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_bypass_lan"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/primary" />

                    <CheckBox
                        android:id="@+id/bypassIranAppsCheck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tunnel_bypass_ir_apps"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/primary" />
                    <TextView
                        android:id="@+id/tunSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textSize="12sp"
                        android:textIsSelectable="true"
                        android:textColor="@color/text_secondary" />
                    <CheckBox
                        android:id="@+id/muxCheck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tunnel_mux"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/primary" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_bypass_lan_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginStart="36dp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/separator" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <CheckBox
                        android:id="@+id/ipv6Check"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tunnel_ipv6"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/primary" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tunnel_ipv6_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginStart="36dp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/separator" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <CheckBox
                        android:id="@+id/unmeteredHintCheck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_unmetered_hint"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/primary" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_unmetered_hint_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginStart="36dp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/separator" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <CheckBox
                        android:id="@+id/screenshotProtectionCheck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_screenshot_protection"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/primary" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_screenshot_protection_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginStart="36dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/SettingsSectionLabel"
                android:text="@string/tunnel_section_system" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card"
                android:padding="4dp">

                <LinearLayout
                    android:id="@+id/systemVpnSettingsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_system_vpn_settings"
                        android:textColor="@color/text_primary" />
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
