<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- نوار بالا: اسکن QR | ستاره‌ها، افزودن، منو -->
    <ImageButton
        android:id="@+id/scanQrButton"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:padding="9dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_qr"
        android:contentDescription="@string/configs_scan_qr"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/menuButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:padding="11dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_list"
        android:contentDescription="@string/configs_menu"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="@id/scanQrButton"
        app:layout_constraintBottom_toBottomOf="@id/scanQrButton"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/addConfigButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:padding="9dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_add"
        android:contentDescription="@string/configs_add"
        app:layout_constraintTop_toTopOf="@id/scanQrButton"
        app:layout_constraintBottom_toBottomOf="@id/scanQrButton"
        app:layout_constraintEnd_toStartOf="@id/menuButton" />

    <!-- دکمه‌ی جدا و مشخص «لینک ساب» (مثل ویندوز) تا مشتری تازه‌کار سردرگم نشود -->
    <TextView
        android:id="@+id/subChipButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="@string/sub_chip"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingStart="12dp"
        android:paddingEnd="14dp"
        android:background="@drawable/bg_sub_chip"
        android:drawableStart="@drawable/ic_add"
        android:drawableTint="#FFFFFF"
        android:drawablePadding="4dp"
        android:layout_marginEnd="6dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/scanQrButton"
        app:layout_constraintBottom_toBottomOf="@id/scanQrButton"
        app:layout_constraintEnd_toStartOf="@id/favoritesButton" />

    <ImageButton
        android:id="@+id/favoritesButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:padding="11dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_star_outline"
        android:contentDescription="@string/configs_favorites"
        app:layout_constraintTop_toTopOf="@id/scanQrButton"
        app:layout_constraintBottom_toBottomOf="@id/scanQrButton"
        app:layout_constraintEnd_toStartOf="@id/addConfigButton" />

    <TextView
        android:id="@+id/configsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tab_configs"
        android:textColor="@color/text_primary"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/scanQrButton"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- نوار مرتب‌سازی + پینگ همه -->
    <LinearLayout
        android:id="@+id/sortBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/configsTitle">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_sort" />

        <TextView
            android:id="@+id/sortModeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_by_ping"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:layout_marginStart="8dp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:drawableEnd="@drawable/ic_expand"
            android:drawablePadding="2dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/pingAllButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/configs_ping_all"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <ImageButton
            android:id="@+id/configsSettingsButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/settings_title" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/configsRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/sortBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav" />

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/configs_empty"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/sortBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/bottomNav"
        layout="@layout/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
