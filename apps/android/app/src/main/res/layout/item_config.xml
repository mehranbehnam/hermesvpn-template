<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginTop="8dp">

    <!-- نشان پروتکل، عمودی — مثل V2Box -->
    <TextView
        android:id="@+id/protocolBadge"
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:minHeight="76dp"
        android:background="@drawable/bg_protocol_badge"
        android:gravity="center"
        android:rotation="0"
        android:textColor="@color/text_on_primary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/configBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_config_item"
        android:padding="14dp"
        android:layout_marginStart="8dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/configName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/configFavorite"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_star"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/configAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/configPing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ping_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textSize="11sp"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- کنش‌ها: ویرایش، اشتراک، حذف -->
        <LinearLayout
            android:id="@+id/configActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/configEditButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_edit"
                android:contentDescription="@string/action_rename" />

            <ImageButton
                android:id="@+id/configFavoriteButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_star_outline"
                android:contentDescription="@string/configs_favorites" />

            <ImageButton
                android:id="@+id/configShareButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_share"
                android:contentDescription="@string/action_share" />

            <ImageButton
                android:id="@+id/configDeleteButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                android:contentDescription="@string/action_delete" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
