<?xml version="1.0" encoding="utf-8"?>
<!-- حالت قطع: نقره‌ای خنثی، هنوز براق -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="@color/silver_1"
                android:endColor="@color/silver_3" />
        </shape>
    </item>
    <item android:top="6dp" android:left="18dp" android:right="18dp" android:bottom="70dp">
        <shape android:shape="oval">
            <solid android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>
